NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nazagestao
CORS_ORIGIN=http://localhost:5173
# Gere valores aleatórios fortes (mínimo 32 caracteres). Nunca publique o arquivo .env.
JWT_SECRET=CHANGE_ME_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
BOOTSTRAP_SECRET=CHANGE_ME_WITH_ANOTHER_RANDOM_SECRET
